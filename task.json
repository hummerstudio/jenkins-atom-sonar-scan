{
  "atomCode": "sonar-scan",
  "name": "SonarQube scan",
  "version": "1.0.1",
  "description": "Runs sonar-scanner and, unless told not to, holds the build until the quality gate answers.",
  "execution": {
    "packagePath": "sonar-scan.jar",
    "language": "java",
    "target": "$atom_java_path -cp sonar-scan.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "projectKey": {
      "label": "项目 key（必填）",
      "type": "vuex-input",
      "default": ""
    },
    "hostUrl": {
      "label": "SonarQube 地址",
      "type": "vuex-input",
      "default": "https://sonarcloud.io"
    },
    "scanner": {
      "label": "scanner 命令",
      "type": "vuex-input",
      "default": "sonar-scanner"
    },
    "sources": {
      "label": "源码目录",
      "type": "vuex-input",
      "default": "."
    },
    "exclusions": {
      "label": "排除规则（sonar.exclusions）",
      "type": "vuex-input",
      "default": ""
    },
    "extraArgs": {
      "label": "额外 -D 参数（空格分隔）",
      "type": "vuex-input",
      "default": ""
    },
    "waitForQualityGate": {
      "label": "等待质量门禁结果",
      "type": "checkbox",
      "default": "true"
    },
    "gateTimeoutSeconds": {
      "label": "等待超时（秒）",
      "type": "vuex-input-number",
      "default": "300"
    },
    "failOnGate": {
      "label": "门禁未通过让构建失败",
      "type": "checkbox",
      "default": "true"
    },
    "sonarToken": {
      "label": "SonarQube Token（凭据 id，Secret text）",
      "type": "vuex-input",
      "default": "",
      "isSensitive": true
    }
  },
  "output": {
    "dashboardUrl": {
      "type": "string",
      "description": "SonarQube 项目看板地址"
    },
    "taskId": {
      "type": "string",
      "description": "计算引擎任务 id"
    },
    "qualityGate": {
      "type": "string",
      "description": "OK / ERROR / UNKNOWN"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    },
    "secrets": {
      "sonarToken": ""
    }
  }
}
